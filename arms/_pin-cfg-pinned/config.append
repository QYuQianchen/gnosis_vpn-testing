
[strategy]
min_open_channels    = 1
target_open_channels = 1

[strategy.channel_allowlist]
enabled = true
peers   = ["@RELAY@"]

# ...and the return leg pinned too. Its partner arm holds the same trimmed
# channel set with the return draw left free; the gap between the two is the
# return leg's contribution, isolated.
[connection.path_planner]
max_cached_paths = 1
return_path_exploration = 0.0
